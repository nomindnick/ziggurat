# Ziggurat league-state sync schedule (item 3.1) — systemd USER timer.
#
# FOUR runs a day. The snapshot tables are day-granular (the last successful pull
# of a day is that day's snapshot), so the extra runs do not add rows — they buy
# two things that matter more:
#
#   1. RESILIENCE. One nightly run means one transient failure (flaky ESPN,
#      asleep laptop, expired cookie noticed late) costs a day of history that
#      can never be recovered. With four attempts, a day is lost only if all
#      four fail.
#   2. CROSS-DAY EVENT TRANSITIONS. league_transactions is write-on-change, so a
#      waiver claim proposed one day and processed in ESPN's ~03:00-04:30 ET
#      overnight batch is stored as TWO versions — the 23:15 run sees it PENDING,
#      the 05:15 run sees it EXECUTED. Note the limit precisely: versions are
#      keyed by retrieved_as_of, which is a DAY, so two transitions within one
#      calendar day collapse to the last one. The real waiver case spans days;
#      same-day churn does not survive.
#
# Times are chosen around the league's rhythm (SPEC): ESPN processes waiver
# claims ~03:00-04:30 ET Wednesday, so the 05:15 run lands just after the batch
# and before the operator's breakfast read; 17:15 precedes Thursday kickoff;
# 23:15 closes the day out.

[Unit]
Description=Ziggurat league-state snapshot schedule
Documentation=file://@REPO@/IMPLEMENTATION_PLAN.md

[Timer]
OnCalendar=*-*-* 05,11,17,23:15:00
# SUNDAY PRE-LOCK RUNS (edge program 2026-09-13, P1; operator decision
# 2026-09-13). The NFL posts inactives ~90 min before each kickoff wave: ~08:30 PT
# for the 10:00 PT wave and ~11:35 PT for the 13:05/13:25 PT wave. Nothing in the
# 6-hourly schedule falls between either report and its locks, so a Sunday
# scratch was invisible to `ziggurat lineup` until after the game started — and
# the phone's INJURY_OUT alerts ride the sync boundary, not the 20-min news tick
# (measured: all six ever pushed landed 1-5 min after a sync). These two runs
# close both gaps; the 20-min alert tick then pushes within ~6 min. Backup for
# the operator's own Sunday check, not a replacement for it. Times are the box's
# local clock (Pacific on the desktop that runs the cadence).
OnCalendar=Sun *-*-* 09:15:00
OnCalendar=Sun *-*-* 12:15:00
# Persistent: if the machine was asleep/off at the scheduled time, run at the
# next opportunity rather than skipping the day (a laptop WILL miss slots).
Persistent=true
# Do not hit ESPN from every machine at exactly :15.
RandomizedDelaySec=300
AccuracySec=1m
Unit=ziggurat-league-sync.service

[Install]
WantedBy=timers.target
